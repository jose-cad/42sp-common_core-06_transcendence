# Copie este arquivo para ".env" e preencha com valores reais.
# O ".env" nunca deve ser commitado (adicionar ao .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=transcendence
POSTGRES_USER=transcendence_user
POSTGRES_PASSWORD=change_me

# --- RabbitMQ ---
RABBITMQ_USER=transcendence
RABBITMQ_PASSWORD=change_me

# --- Backend (.NET) ---
ASPNETCORE_ENVIRONMENT=Development
JWT_SECRET=change_me_to_a_long_random_string

# --- OCR service (Python + Gemini) ---
# Gerar chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Pix service (Python) ---
# Recomendado: criar uma conta de e-mail dedicada só para receber comprovantes.
# Se usar Gmail, IMAP_PASSWORD deve ser uma "senha de app", não a senha normal.
IMAP_HOST=imap.gmail.com
IMAP_USER=empresa@example.com
IMAP_PASSWORD=change_me
